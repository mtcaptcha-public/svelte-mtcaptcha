{
  "name": "svelte-mtcaptcha",
  "version": "1.0.0",
  "description": "Official Svelte plugin for MTCaptcha. Renders the widget in Svelte apps and verifies tokens on the server.",
  "author": "MTCaptcha Public",
  "license": "MIT",
  "homepage": "https://github.com/mtcaptcha-public/svelte-mtcaptcha#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mtcaptcha-public/svelte-mtcaptcha.git"
  },
  "bugs": {
    "url": "https://github.com/mtcaptcha-public/svelte-mtcaptcha/issues"
  },
  "keywords": [
    "svelte",
    "svelte-plugin",
    "mtcaptcha",
    "captcha",
    "security"
  ],
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "server": [
        "dist/server.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && svelte-package -i src -o dist && tsup --config tsup.server.config.ts",
    "test": "node --experimental-strip-types --test test/**/*.test.ts",
    "prepublishOnly": "npm test && npm run build",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.3.7",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/node": "^22.10.2",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.4",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
